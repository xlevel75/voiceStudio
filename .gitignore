# 의존성
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/versions

# Next.js 빌드 산출물
/.next/
/out/
/build
/.turbo
next-env.d.ts

# 타입스크립트
*.tsbuildinfo

# 테스트 / 커버리지
/coverage

# 환경 변수 — API 키가 들어가므로 절대 커밋하지 않는다
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local

# 배포 도구
.vercel

# data/ (성우 목록 JSON, 뉴스 팟캐스트 주제 JSON·이미지)는 함께 커밋한다.
# 주제를 저장할 때 잠깐 생기는 임시 파일만 뺀다.
/data/podcasts/*.tmp

# 로그
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS / 에디터
.DS_Store
Thumbs.db
*.pem
.idea/
*.swp
