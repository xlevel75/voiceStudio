# 모두 서버사이드 전용. NEXT_PUBLIC_ 접두사를 절대 붙이지 말 것.

# ElevenLabs
ELEVENLABS_API_KEY=

# 네이버 CLOVA Voice (NCP)
CLOVA_CLIENT_ID=
CLOVA_CLIENT_SECRET=

# Vercel Blob (성우 만들기용 오디오 업로드)
BLOB_READ_WRITE_TOKEN=

# Blob 스토어의 접근 모드. 스토어 설정과 반드시 일치해야 한다.
# 비워두면 private. 스토어를 public으로 만들었을 때만 public 으로 바꾼다.
BLOB_ACCESS=

# Postgres / Supabase. 비워두면 로컬 JSON 파일 스토어(data/voices.json)로 폴백.
DATABASE_URL=
